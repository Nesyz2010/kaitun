local function hopServer(jobId)
    if realm(s)Id and realm(s)Id ~= game.JobId then
        addLog("Transferring realm: " .. tostring(jobId):sub(1, 16) .. "...", Color3.fromRGB(255, 220, 0))
        game:GetService("ReplicatedStorage"):WaitForChild("__ServerBrowser"):InvokeServer("teleport", realm(s)Id)
