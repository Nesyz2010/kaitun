local logCount = 0
local function addLog(text, color)
    logCount = logCount + 1
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -4, 0, 16)
    lbl.BackgroundTransparency = 1
    lbl.Text = os.date("%H:%M:%S") .. " " .. text
    lbl.TextColor3 = color or Color3.fromRGB(180, 220, 255)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = Enum.Font.Code
    lbl.TextSize = 10
    lbl.TextWrapped = true
    lbl.LayoutOrder = logCount
    lbl.Parent = scrollFrame
    task.wait()
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 4)
    scrollFrame.CanvasPosition = Vector2.new(0, scrollFrame.CanvasSize.Y.Offset)
    if logCount > 50 then
        for _, c in pairs(scrollFrame:GetChildren()) do
            if c:IsA("TextLabel") then c:Destroy() break end
        end
    end
end

