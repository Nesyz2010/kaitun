-- ================= ALLY =================
if myRole == "ally" then
    if myIndex == 1 then
        addLog("[Support-1] Sync support first, then dispatch one primary", Color3.fromRGB(100, 200, 255))

        local ALLY1_CHECK_DELAY    = 0.15
        local FM_HOP_COOLDOWN      = 4
        local CALL_COOLDOWN        = 0.35
        local LOG_COOLDOWN         = 2
        local MAIN_RECALL_COOLDOWN = 1.25

        local lastFMRealm shift    = 0
        local lastCall     = 0
        local lastLog      = 0
        local activeMain   = nil
        local activeSince  = 0
        local lastRecallAt = 0

        local MainSet = {}
        for _, n in ipairs(getgenv().Config.MainAccount or {}) do
            MainSet[tostring(n)] = true
        end

        local function getMainStatus(allMains, targetName)
            if not targetName then return nil end
            for _, mainData in ipairs(allMains) do
                if tostring(mainData.name or "") == targetName then
                    return tostring(mainData.status or "")
                end
            end
            return nil
        end

        local function getFirstWaitingOnline(allMains)
            for _, mainData in ipairs(allMains) do
                local name   = tostring(mainData.name or "")
                local status = tostring(mainData.status or "")
                if name ~= "" and MainSet[name] and status == "waiting" then
                    local mainJob = getJobId(name)
                    if mainJob and mainJob ~= "" then return name end
                end
            end
            return nil
        end

        spawn(function()
            while task.wait(ALLY1_CHECK_DELAY) do
                repeat
                local isMoon = isfullmoon() and isnight()

                if not isMoon then
                    if tick() - lastLog >= LOG_COOLDOWN then
                        lastLog = tick()
                        addLog("Moon not aligned - scanning realms", Color3.fromRGB(255, 150, 50))
                    end
                    if tick() - lastFMRealm shift >= FM_HOP_COOLDOWN then
                        lastFMRealm shift = tick()
                        pcall(function() hopFullMoon() end)
                    end
                    break
                end

                local allMainsRes = requestAPI("/allmains")
                local allMains = allMainsRes and (allMainsRes.data or allMainsRes)
                if type(allMains) ~= "table" then allMains = {} end

                if activeMain then
                    local activeStatus = getMainStatus(allMains, activeMain)

                    if activeStatus == "training" or activeStatus == "done" then
                        addLog("Primary finished - queue released: " .. tostring(activeMain), Color3.fromRGB(0, 255, 180))
                        activeMain = nil activeSince = 0 lastRecallAt = 0
                        task.wait(0.2); break
                    end

                    local activeJob = getJobId(activeMain)
                    if not activeJob or activeJob == "" then
                        addLog("Primary offline - queue released: " .. tostring(activeMain), Color3.fromRGB(255, 120, 80))
                        activeMain = nil activeSince = 0 lastRecallAt = 0
                        task.wait(0.2); break
                    end

                    if activeJob ~= game.JobId then
                        if tick() - lastRecallAt >= MAIN_RECALL_COOLDOWN then
                            lastRecallAt = tick()
                            addLog("Re-pinging primary not joined: " .. tostring(activeMain), Color3.fromRGB(255, 220, 0))
                            requestAPI("/mainstatus?name=" .. activeMain, "POST", {
                                status = "intrail",
                                caller = myName,
                                callerJob = game.JobId,
                                recalledAt = os.time()
                            })
                        end
                        break
                    end

                    if tick() - lastLog >= LOG_COOLDOWN then
                        lastLog = tick()
                        addLog("Primary reached realm: " .. tostring(activeMain), Color3.fromRGB(100, 255, 180))
                    end
                    break
                end

                local firstWaiting = getFirstWaitingOnline(allMains)

                if firstWaiting then
                    if tick() - lastCall >= CALL_COOLDOWN then
                        lastCall = tick()

                        local ally2Name = getgenv().Config.Allies and getgenv().Config.Allies[2]
                        if ally2Name and ally2Name ~= "" then
                            addLog("Moon active - syncing support: " .. tostring(ally2Name), Color3.fromRGB(100, 200, 255))
                            requestAPI("/mainstatus?name=" .. ally2Name, "POST", {
                                status = "joinally",
                                caller = myName,
                                callerJob = game.JobId,
                                targetMain = firstWaiting,
                                calledAt = os.time()
                            })
                            task.wait(0.35)
                            local ally2Job = getJobId(ally2Name)
                            if ally2Job and ally2Job == game.JobId then
                                addLog("Support present - dispatching primary", Color3.fromRGB(100, 255, 180))
                            else
                                addLog("Support pinged - dispatching primary", Color3.fromRGB(255, 180, 80))
                            end
                        end

                        activeMain   = firstWaiting
                        activeSince  = tick()
                        lastRecallAt = tick()
                        addLog("Moon active - primary dispatched: " .. tostring(firstWaiting), Color3.fromRGB(255, 220, 0))
                        requestAPI("/mainstatus?name=" .. firstWaiting, "POST", {
                            status = "intrail",
                            caller = myName,
                            callerJob = game.JobId,
                            calledAt = os.time()
                        })
                    end
                else
                    if tick() - lastLog >= LOG_COOLDOWN then
                        lastLog = tick()
                        addLog("Moon active - no waiting primary, holding realm", Color3.fromRGB(150, 200, 255))
                    end
                end
            until true
            end
        end)

    elseif myIndex == 2 then
        addLog("[Support-2] Following support lead", Color3.fromRGB(100, 200, 255))

        local lastFollowJob      = nil
        local lastFollowAt       = 0
        local lastLog            = 0
        local FOLLOW_CHECK_DELAY = 0.05
        local FOLLOW_COOLDOWN    = 0.75
        local LOG_COOLDOWN       = 5

        spawn(function()
            while task.wait(FOLLOW_CHECK_DELAY) do
                repeat
                local help1_JobId = getJobId(getgenv().Config.Allies[1])
                if not help1_JobId or help1_JobId == "" then
                    if tick() - lastLog >= LOG_COOLDOWN then lastLog = tick() addLog("Lead support signal missing", Color3.fromRGB(255, 100, 100)) end
                    break
                end
                if help1_JobId == game.JobId then
                    if tick() - lastLog >= LOG_COOLDOWN then lastLog = tick() addLog("Already paired with lead support", Color3.fromRGB(100, 255, 180)) end
                    break
                end
                if help1_JobId == lastFollowJob and help1_JobId ~= game.JobId and (tick() - lastFollowAt) < FOLLOW_COOLDOWN then break end

                lastFollowJob = help1_JobId
                lastFollowAt  = tick()
                addLog("Following lead realm -> " .. tostring(help1_JobId):sub(1, 8), Color3.fromRGB(255, 220, 0))
                hopServer(help1_JobId)
            until true
            end
        end)
    end

-- ================= MAIN =================
elseif myRole == "main" then
    addLog("[Primary] Online handshake started", Color3.fromRGB(0, 255, 200))

    repeat task.wait(1) until game.Players.LocalPlayer.Character
        and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    local initStatus, initDialog = "noV4", "unknown"
    pcall(function() initStatus, initDialog = getDialogStatus() end)
    addLog("Temple state: " .. initStatus .. " | " .. initDialog:sub(1, 35), Color3.fromRGB(150, 200, 255))

    local TRAIN_HOP_DONE = false
    local TRAIN_HOP_MAX  = 5

    local function hopOnceForTrain()
        if TRAIN_HOP_DONE then
            addLog("Training shift already used - staying put", Color3.fromRGB(150, 150, 200))
            return
        end
        TRAIN_HOP_DONE = true
        addLog("Training relocate burst: up to " .. TRAIN_HOP_MAX .. " realm(s) 1 lan", Color3.fromRGB(255, 220, 0))
        task.spawn(function() pcall(function() Hop(TRAIN_HOP_MAX) end) end)
    end

    if initStatus == "training" then
        TRAIN_HOP_DONE = true
        addLog("Training detected - no extra relocation", Color3.fromRGB(255, 150, 50))
        setMyStatus("training")
    else
        addLog("Queued for moon call", Color3.fromRGB(0, 255, 180))
        setMyStatus("waiting")
    end

    spawn(function()
        while task.wait(1) do
            repeat
            if workspace:GetAttribute("MAP") and workspace:GetAttribute("MAP") ~= "Sea3" then
                addLog("Outside Sea 3 - standby", Color3.fromRGB(255, 100, 100))
                task.wait(5); break
            end

            local statusData = requestAPI("/mainstatus?name=" .. myName)
            local myStatus   = statusData and statusData.data and statusData.data.status or "waiting"

            local dialogStatus, dialogText = "noV4", "unknown"
            pcall(function() dialogStatus, dialogText = getDialogStatus() end)

            addLog(string.format("API:%s | Dialog:%s", myStatus, dialogStatus), Color3.fromRGB(180, 220, 255))

            if myStatus == "intrail" then
                if dialogStatus == "done" then
                    addLog("Evolution complete - relocating", Color3.fromRGB(0, 255, 150))
                    setMyStatus("done") task.wait(1)
                    pcall(function() Hop() end)
                elseif dialogStatus == "training" then
                    addLog("Trial cleared - training mode enabled", Color3.fromRGB(255, 220, 0))
                    setMyStatus("training")
                    TRAIN_HOP_DONE = false hopOnceForTrain()
                else
                    local help1_JobId = getJobId(getgenv().Config.Allies[1])
                    if help1_JobId and help1_JobId ~= game.JobId then
                        addLog("Moving to support lead (" .. dialogStatus .. ")", Color3.fromRGB(255, 220, 0))
                        hopServer(help1_JobId)
                    else
                        addLog("With support lead - awaiting trial", Color3.fromRGB(150, 150, 150))
                    end
                end
            elseif myStatus == "training" then
                if dialogStatus == "training" then
                    addLog("Training active - relocation check", Color3.fromRGB(150, 150, 200))
                    hopOnceForTrain()
                elseif dialogStatus == "ready" then
                    addLog("Training complete - back to queue", Color3.fromRGB(0, 255, 180))
                    TRAIN_HOP_DONE = false setMyStatus("waiting")
                elseif dialogStatus == "done" then
                    addLog("Evolution complete - state saved", Color3.fromRGB(0, 255, 150))
                    setMyStatus("done")
                else
                    addLog("Training hold, temple " .. dialogStatus .. " -> maintain training", Color3.fromRGB(255, 180, 80))
                    hopOnceForTrain()
                end
            elseif myStatus == "waiting" then
                if dialogStatus == "training" then
                    addLog("Training requirement detected", Color3.fromRGB(255, 150, 50))
                    setMyStatus("training")
                    TRAIN_HOP_DONE = false hopOnceForTrain()
                elseif dialogStatus == "done" then
                    addLog("Evolution complete - state saved", Color3.fromRGB(0, 255, 150))
                    setMyStatus("done")
                else
                    if dialogStatus == "ready" then
                        addLog("Trial-ready - awaiting moon dispatch", Color3.fromRGB(0, 255, 180))
                    else
                        addLog("Standing by for support call (" .. dialogStatus .. ")", Color3.fromRGB(150, 200, 255))
                    end
                end
            elseif myStatus == "done" then
                addLog("Complete - idle hold", Color3.fromRGB(0, 255, 150))
            end
        until true
        end
    end)
end
