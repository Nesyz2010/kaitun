-- ================= HELPERS =================
function isnight()
    local c = game.Lighting.ClockTime
    return (c >= 16 or c < 5)
end

function isfullmoon()
    return game:GetService("Lighting"):GetAttribute("MoonPhase") == 5
end

function getdialogoftemple()
    local ok, i, d, f = pcall(function()
        return game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("UpgradeRace", "Check")
    end)
    if not ok then return "You have yet to achieve greatness", nil, nil, nil end
    if i == 5 then return "You Are Done Your Race", i, d, f
    elseif i == 6 then return "Upgrades completed: " .. tostring((d or 2) - 2) .. "/3, Need Trains More", i, d, f
    elseif i == 1 or i == 3 then return "Please Train More", i, d, f
    elseif i == 2 or i == 4 or i == 7 then return "You Can Buy Gear With " .. tostring(f or 0) .. " Fragments", i, d, f
    elseif i == 0 then return "You Are Ready For Trial [Gear: " .. tostring(d or "?") .. "]", i, d, f
    elseif i == 8 then return "Remaining " .. tostring(10 - (d or 0)) .. " training sessions.", i, d, f
    else return "You have yet to achieve greatness", i, d, f
    end
end

local function getDialogStatus()
    local ok, dialog, i, d, f = pcall(getdialogoftemple)
    if not ok then return "noV4", "You have yet to achieve greatness" end
    if i == 5 then return "done", dialog
    elseif i == 0 or i == 2 or i == 4 or i == 7 then return "ready", dialog
    elseif i == 1 or i == 3 or i == 6 or i == 8 then return "training", dialog
    else return "noV4", dialog
    end
end

local function requestAPI(endpoint, method, body)
    local success, result = pcall(function()
        local req = (http_request or http and http.request or request)
        return req({
            Url = BASE_URL .. endpoint,
            Method = method or "GET",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body and game.HttpService:JSONEncode(body) or nil
        })
    end)
    if success and result and result.Body and result.Body ~= "" then
        local ok, data = pcall(function() return game.HttpService:JSONDecode(result.Body) end)
        if ok then return data end
    end
    return nil
end

