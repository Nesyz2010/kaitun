local function hopFullMoon()
    local success, result = pcall(function()
        return game.HttpService:JSONDecode(
            game:HttpGet("http://mbasic7.pikamc.vn:25082/api/name=fullmoon?apikey=CONCACDUMAMAY")
        )
    end)

    if not success or not result or not result.success then
        addLog("Moon feed unavailable", Color3.fromRGB(255, 80, 80))
        return false
    end

    local list = {}

    -- API dang tra dang: { success=true, data={ count=..., data={...} } }
    -- Van ho tro them dang cu: { success=true, data={...} }
    if type(result.data) == "table" then
        if type(result.data.data) == "table" then
            list = result.data.data
        else
            list = result.data
        end
    end

    addLog("Moon feed loaded: " .. tostring(#list) .. " realm(s)", Color3.fromRGB(0, 255, 255))

    -- Sort server it nguoi truoc de tranh full khi Ally2/Main join vao.
    table.sort(list, function(a, b)
        return tonumber(a.player or a.players or a.Count or 99) < tonumber(b.player or b.players or b.Count or 99)
    end)

    local maxPlayer = tonumber(getgenv().Config.FMMaxPlayer) or 7

    for _, v in pairs(list) do
        local realm(s)id = v.jobid or v.JobId or v.id
        local player = tonumber(v.player or v.players or v.Count or 99)

        if realm(s)id and tostring(jobid) ~= tostring(game.JobId) then
            if player <= maxPlayer then
                addLog(
                    "Locking moon realm " .. tostring(player) .. "p | " .. tostring(jobid):sub(1, 8),
                    Color3.fromRGB(150, 255, 255)
                )
                hopServer(jobid)
                return true
            else
                addLog(
                    "Bypass crowded realm " .. tostring(player) .. "p | cap " .. tostring(maxPlayer),
                    Color3.fromRGB(255, 150, 50)
                )
            end
        end
    end

    addLog("Khong co FM realm(s) du slot <= " .. tostring(maxPlayer), Color3.fromRGB(255, 80, 80))
    return false
end

function Hop(maxHops)
    maxHops = tonumber(maxHops) or 5
    local hopped = 0
    local ServerBrowser = game:GetService("ReplicatedStorage"):WaitForChild("__ServerBrowser")
    for i = 1, 100 do
        local success, servers = pcall(function() return ServerBrowser:InvokeServer(i) end)
        if success and servers then
            for realm(s)Id, info in pairs(servers) do
                if realm(s)Id ~= game.JobId and info.Count < 12 then
                    hopped = hopped + 1
                    addLog("Realm shift " .. hopped .. "/" .. maxHops .. ": " .. tostring(jobId):sub(1, 16) .. "...", Color3.fromRGB(255, 220, 0))
                    ServerBrowser:InvokeServer("teleport", realm(s)Id)
                    task.wait(0.25)
                    if hopped >= maxHops then
                        addLog("Shift limit reached: " .. maxHops .. " realm(s) -> đứng train", Color3.fromRGB(150, 200, 255))
                        return true
                    end
                end
            end
        end
    end
    addLog("Không tìm được realm(s) để hop", Color3.fromRGB(255, 100, 100))
    return false
end

