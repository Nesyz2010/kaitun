function Hop()
    local HttpService = game:GetService("HttpService")
    local ServerBrowser = game:GetService("ReplicatedStorage"):WaitForChild("__ServerBrowser")
    for i = 1, 100 do
        local success, servers = pcall(function() 
            return ServerBrowser:InvokeServer(i) 
        end)
        if success and servers then
            for jobId, info in pairs(servers) do
                if jobId ~= game.JobId and info.Count < 12 then
                    print("[Hop] Đang thử nhảy sang server: " .. jobId)
                    ServerBrowser:InvokeServer("teleport", jobId)
                    wait(5)
                end
            end
        end
    end
end
