local function getJobId(playerName)
    local data = requestAPI("/noguchi?name=" .. playerName)
    if data and data.data and data.data.jobid then
        return data.data.jobid
    end
    return nil
end

local function setMyStatus(status)
    requestAPI("/mainstatus?name=" .. myName, "POST", { status = status })
end

local function hopServer(jobId)
    if jobId and jobId ~= game.JobId then
        game:GetService("ReplicatedStorage"):WaitForChild("__ServerBrowser"):InvokeServer("teleport", jobId)
    end
end

local function hopFullMoon()
    local success, result = pcall(function()
        return game.HttpService:JSONDecode(game:HttpGet("http://fi11.bot-hosting.net:20758/api/name=fullmoon"))
    end)
    if success and result and result.success and result.data then
        for _, v in pairs(result.data) do
            if v.jobid and v.jobid ~= game.JobId and v.player >= 8 then
                hopServer(v.jobid)
                return true
            end
        end
    end
    return false
end

function getCurrentTier()
    local success, i, d, f = pcall(function()
        return game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("UpgradeRace", "Check")
    end)
    if success and type(d) == "number" then return d end
    return 0 
end


